│   │   └── MovieDatabase.kt
│   └── favoritemovies/
│       └── FavoriteMovieDao.kt
├── entities/                       # Data transfer objects (DTOs) & DB Entities
│   ├── MovieData.kt
│   └── MovieDbData.kt
├── mapper/                         # Mappers (Data <-> Domain)
│   └── MovieDataMapper.kt
├── repository/                     # Repository implementations
│   ├── MovieRepositoryImpl.kt
│   ├── MovieDataSource.kt
│   └── MovieLocalDataSource.kt
└── util/                           # Data utilities
